# Base URL of the backend API (no trailing slash).
#
# Local development: the FastAPI default.
# Production: your Render URL, e.g. https://civic-services-api.onrender.com
#
# This is a NEXT_PUBLIC_ variable, so it is inlined into the client bundle at build
# time — changing it on Vercel requires a redeploy, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Credentials shown on the staff sign-in page. The working values are committed in
# src/app/admin/login/page.tsx so the panel needs no configuration at all; these two
# variables only override them. Set NEXT_PUBLIC_DEMO_PASSWORD to an empty string to
# hide the panel entirely.
#
# Whatever ends up shown must match ADMIN_PASSWORD on the API, or the page advertises a
# credential that does not work — which is worse than showing nothing.
#
# Like every NEXT_PUBLIC_ variable these are compiled into the bundle, so changing them
# requires a rebuild, not just a restart.
# NEXT_PUBLIC_DEMO_EMAIL=admin@civic.gov
# NEXT_PUBLIC_DEMO_PASSWORD=
