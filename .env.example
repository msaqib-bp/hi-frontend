# Base URL of the backend API (no trailing slash).
#
# Local development: the FastAPI default.
# Production: your Render URL, e.g. https://civic-services-api.onrender.com
#
# This is a NEXT_PUBLIC_ variable, so it is inlined into the client bundle at build
# time — changing it on Vercel requires a redeploy, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:8000
