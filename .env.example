# Base URL of the backend API (no trailing slash).
#
# Local development: the FastAPI default.
# Production: your Render URL, e.g. https://civic-services-api.onrender.com
#
# This is a NEXT_PUBLIC_ variable, so it is inlined into the client bundle at build
# time — changing it on Vercel requires a redeploy, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Credentials printed on the staff sign-in page so a judge can get in without being
# handed them separately. Leave NEXT_PUBLIC_DEMO_PASSWORD unset and the panel is hidden.
#
# Deliberately not committed with a value: this repository is public, and a working
# password committed here would stay in the git history permanently. It must also match
# ADMIN_PASSWORD on the API, or the page advertises a credential that does not work.
#
# Like every NEXT_PUBLIC_ variable it is compiled into the bundle, so changing it
# requires a rebuild, not just a restart.
NEXT_PUBLIC_DEMO_EMAIL=admin@civic.gov
NEXT_PUBLIC_DEMO_PASSWORD=
